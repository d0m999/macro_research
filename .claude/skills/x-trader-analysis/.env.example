# X Trader Analysis — 环境变量模板
# 把本文件复制为 .env 并填入实际凭证, .env 不要提交到 git

# ============================================================
# 主方案: Apify Twitter Scraper (推荐)
# ============================================================
# 申请方式:
# 1. 访问 https://console.apify.com/sign-up 注册账号
# 2. 进入 https://console.apify.com/account/integrations
# 3. 复制 Personal API token
# 4. 计费: 按用量约 $5/万条推文, 新用户有免费额度
APIFY_TOKEN=

# 可选: 指定 Apify Actor (默认用 quacker/twitter-scraper)
# 备选 actor: apidojo/twitter-scraper-lite (更便宜)
APIFY_ACTOR_ID=quacker/twitter-scraper


# ============================================================
# 备选方案 A: Scweet 本地爬虫
# ============================================================
# Scweet 通过 Selenium 模拟浏览器, 需要导出 X 登录 cookies
# 步骤:
# 1. Chrome 安装扩展 "EditThisCookie" 或 "Cookie-Editor"
# 2. 登录 https://x.com
# 3. 导出 cookies 为 JSON 格式
# 4. 保存到本目录的 cookies.json
# 注意:
# - cookies 有效期约 30 天, 过期需重新导出
# - 同一 cookies 不要高频爬, 易被封号
SCWEET_COOKIES_PATH=cookies.json

# Selenium 浏览器路径 (留空用自动检测)
SCWEET_CHROME_PATH=
SCWEET_HEADLESS=true


# ============================================================
# 备选方案 B: X API v2 官方
# ============================================================
# 申请方式:
# 1. 访问 https://developer.x.com/en/portal/dashboard
# 2. 创建 Project + App
# 3. 复制 Bearer Token
# 限制:
# - Free tier: 仅 100 推文/月, 不可用
# - Basic ($100/月): 仅 7 天历史
# - Pro ($5000/月): 仅 6 个月历史
# 结论: 不适合本 skill 的长期历史分析, 仅做兜底
X_API_BEARER_TOKEN=


# ============================================================
# 通用配置
# ============================================================
# 爬虫请求间隔 (秒), 防风控
SCRAPE_RATE_LIMIT_SECONDS=2

# 单次最大爬取条数 (防失控)
SCRAPE_MAX_TWEETS=5000

# 数据输出根目录 (相对项目根)
DATA_ROOT=data
