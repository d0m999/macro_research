//@version=6
indicator("历史 PE 倍数（TTM）", shorttitle="PE Hist", overlay=false, precision=1)

// ============================================================================
// 历史 PE(TTM) 序列：现价 / 摊薄 EPS(TTM)
// 用途：回看任意历史时点的估值水位（配合 Herman 框架：PE 要对着增长看）
// 验收：粘贴进 TradingView Pine 编辑器编译，日线级别目检
// ============================================================================

// ---- 输入 ----
symbolInput = input.symbol("", "标的（留空 = 当前图表标的）")
medianLen   = input.int(500, "中位数窗口（交易日，500 ≈ 2 年）", minval = 50)
showBands   = input.bool(true, "显示历史中位数 ±1σ 参考带")

src = symbolInput == "" ? syminfo.tickerid : symbolInput

// ---- 取数 ----
// gaps=barmerge.gaps_off：财报值发布后向前填充，形成连续的 EPS(TTM) 阶梯序列
epsTtm = request.financial(src, "EARNINGS_PER_SHARE_DILUTED_TTM", "TTM",
     gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
price  = request.security(src, timeframe.period, close,
     gaps = barmerge.gaps_off, ignore_invalid_symbol = true)

// EPS ≤ 0（亏损期）PE 无意义，显示为断点而不是负数
pe = epsTtm > 0 ? price / epsTtm : na

// ---- 统计参考 ----
medianPe = ta.median(pe, medianLen)
stdevPe  = ta.stdev(pe, medianLen)
upperBand = medianPe + stdevPe
lowerBand = math.max(medianPe - stdevPe, 0)

// 历史分位：当前 PE 在过去 N 天里的百分位
pctRank = ta.percentrank(pe, medianLen)

// ---- 画图 ----
plot(pe, "PE(TTM)", color = color.orange, linewidth = 2)
plot(showBands ? medianPe : na, "历史中位数", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(showBands ? upperBand : na, "+1σ", color = color.new(color.red, 60))
plot(showBands ? lowerBand : na, "-1σ", color = color.new(color.green, 60))
hline(0, "零线", color = color.new(color.gray, 70))

// ---- 右上角信息卡 ----
var table info = table.new(position.top_right, 2, 4,
     bgcolor = color.new(color.black, 20), border_width = 1)

if barstate.islast
    table.cell(info, 0, 0, "当前 PE", text_color = color.white)
    table.cell(info, 1, 0, na(pe) ? "亏损/无数据" : str.tostring(pe, "#.0") + "x",
         text_color = color.orange)
    table.cell(info, 0, 1, "中位数", text_color = color.white)
    table.cell(info, 1, 1, str.tostring(medianPe, "#.0") + "x", text_color = color.white)
    table.cell(info, 0, 2, "历史分位", text_color = color.white)
    table.cell(info, 1, 2, str.tostring(pctRank, "#") + "%",
         text_color = pctRank > 80 ? color.red : pctRank < 20 ? color.green : color.white)
    table.cell(info, 0, 3, "EPS(TTM)", text_color = color.white)
    table.cell(info, 1, 3, na(epsTtm) ? "—" : str.tostring(epsTtm, "#.00"), text_color = color.white)

// ============================================================================
// 已知限制（务必知悉）：
// 1. 财务数据按财报发布节奏阶梯更新；TradingView 按财报期填充历史，
//    极早期数据可能与实际披露日有几天偏差——研究用足够，别拿去做精确回测。
// 2. EPS 为报告货币、价格为交易货币：ADR/跨市场标的（如台积电 TSM）会失真。
// 3. 亏损期显示断点，是特性不是 bug（负 PE 没有信息量）。
// 4. request.financial 可用字段和深度取决于 TradingView 套餐。
// 5. 指数（SPX）没有 financial 字段，Herman 引用的标普 19.3x 是高盛 QSAR
//    口径，本脚本只适用于个股。
// ============================================================================
