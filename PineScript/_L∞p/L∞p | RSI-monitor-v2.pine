        => ticker  // 默认返回原始代码
    name


// =================================================================================
// 全局辅助函数
// =================================================================================

pine_rsi(x, y) => 
    u = math.max(x - x[1], 0)
    d = math.max(x[1] - x, 0)
    alpha = 1 / y
    float sum_u = 0.0
    float sum_d = 0.0
    sum_u := alpha * u + (1 - alpha) * nz(sum_u[1])
    sum_d := alpha * d + (1 - alpha) * nz(sum_d[1])
    rs = sum_u / sum_d
    100 - 100 / (1 + rs)

f_atan2(y, x) =>
    float ret = na
    if x > 0
        ret := math.atan(y / x)
    else if x < 0 and y >= 0
        ret := math.atan(y / x) + math.pi
    else if x < 0 and y < 0
        ret := math.atan(y / x) - math.pi
    else if y > 0
        ret := math.pi / 2
    else if y < 0
        ret := -math.pi / 2
    else
        ret := 0.0
    ret

// =================================================================================
// 核心计算表达式函数 - 返回 RSI 值
// =================================================================================

f_expressionForSecurity() =>
    price = close
    priceSmooth = (price + price[1] + price[2] + price[3]) / 4
    detrender = (0.0962 * priceSmooth + 0.5769 * priceSmooth[2] - 0.5769 * priceSmooth[4] - 0.0962 * priceSmooth[6])
    I1 = detrender[3]
    Q1 = (0.0962 * detrender + 0.5769 * detrender[2] - 0.5769 * detrender[4] - 0.0962 * detrender[6])
    jI = I1[3]
    jQ = Q1[3]
    I2 = I1 - jQ
    Q2 = Q1 + jI
    Re = I2 * nz(I2[1]) + Q2 * nz(Q2[1])
    Im = I2 * nz(Q2[1]) - Q2 * nz(I2[1])
    phaseAngle = math.todegrees(f_atan2(Im, Re))
    phaseAngle := phaseAngle < 0 ? phaseAngle + 360 : phaseAngle
    minPhase = 1.0
    phaseAngleClamped = math.max(phaseAngle, minPhase)
    hilbertPeriodRaw = 360 / phaseAngleClamped
    market_frequency = ta.median(hilbertPeriodRaw, medianLength)
    period = int(market_frequency / 2)
    base_rsi = pine_rsi(price, period)
    sm = smooth
    smLen = smoothlength
    rsi_result = sm ? ta.hma(base_rsi, smLen) : base_rsi
    rsi_result

// =================================================================================
// 计算模块 (全局作用域)
// =================================================================================
// 将所有代币和RSI值存储在数组中
string[] symbols = array.from(s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40)
float[] rsi_values = array.new_float(40)

for i = 0 to array.size(symbols) - 1
    symbol_id = array.get(symbols, i)
    if str.length(symbol_id) > 0
        rsi_value = request.security(symbol_id, timeframe.period, f_expressionForSecurity())
        array.set(rsi_values, i, rsi_value)
    else
        array.set(rsi_values, i, na)

// =================================================================================
// 表格绘制模块 - 仅显示超买超卖股票
// =================================================================================

// 在全局作用域创建表格，指定位置、列数、行数
var table rsiTable = table.new(position.top_right, 3, 41, border_width = 1)

// 仅在最后一条K线上更新表格，以提高性能
if barstate.islast
    // 清除表格内容（重绘前先清空）
    table.clear(rsiTable, 0, 0, 2, 40)
    
    // 1. 绘制表头
    table.cell(rsiTable, 0, 0, "股票名称", bgcolor=color.gray, text_color=color.white)
    table.cell(rsiTable, 1, 0, "RSI", bgcolor=color.gray, text_color=color.white)
    table.cell(rsiTable, 2, 0, "状态", bgcolor=color.gray, text_color=color.white)

    // 2. 循环填充表格内容
    int currentRow = 1  // 从第1行开始（第0行是表头）
    
    for i = 0 to array.size(symbols) - 1
        string sym_id = array.get(symbols, i)
        float rsi = array.get(rsi_values, i)

        if str.length(sym_id) > 0 and not na(rsi)
            // 判断是否超买或超卖
            bool isOB = rsi > overboughtLevel
            bool isOS = rsi < oversoldLevel
            
            // 根据 showAll 开关决定是否显示
            bool shouldShow = showAll or isOB or isOS
            
            if shouldShow
                // 获取中文名称
                string cname = f_getChineseName(sym_id)
                
                // 根据RSI状态确定背景和文本颜色
                color bg = isOB ? color.new(color.red, 30) : isOS ? color.new(color.green, 30) : color.new(color.gray, 70)
                color txt = color.white
                string st = isOB ? "超买" : isOS ? "超卖" : "正常"

                // 填充单元格
                table.cell(rsiTable, 0, currentRow, cname, bgcolor=bg, text_color=txt)
                table.cell(rsiTable, 1, currentRow, str.tostring(rsi, "0.00"), bgcolor=bg, text_color=txt)
                table.cell(rsiTable, 2, currentRow, st, bgcolor=bg, text_color=txt)
                
                currentRow += 1
    
    // 如果没有任何股票显示，显示提示信息
    if currentRow == 1
        table.cell(rsiTable, 0, 1, "暂无数据", bgcolor=color.new(color.gray, 70), text_color=color.white)
        table.merge_cells(rsiTable, 0, 1, 2, 1)
