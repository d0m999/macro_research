//@version=6
indicator("RSI Monitor v2", "L∞p | RSI Monitor v2", overlay = true)

// =================================================================================
// 参数
// =================================================================================
aro_group = "ARO RSI Settings"
smooth = input.bool(title="Enable Smoothing", defval=true, group=aro_group)
smoothlength = input.int(title="Smoothing Length", defval=12, minval=1, group=aro_group)
medianLength = input.int(title="Frequency Detection Length", defval=100, minval=1, group=aro_group)
overboughtLevel = input.int(title="Overbought Level", defval=80, minval=50, maxval=100, group=aro_group)
oversoldLevel = input.int(title="Oversold Level", defval=20, minval=0, maxval=50, group=aro_group)
showAll = input.bool(title="Show All (Debug Mode)", defval=true, group=aro_group, tooltip="开启后显示所有股票，关闭后仅显示超买超卖")

