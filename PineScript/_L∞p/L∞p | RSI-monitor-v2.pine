    // 使用 syminfo.ticker() 提取纯股票代码（去除交易所前缀如 SSE_DLY: 等）
    string ticker = syminfo.ticker(symbol_id)
    
    // 中文名称映射
    string name = switch ticker
        "688295" => "中科飞测"
        "601600" => "中国铝业"
