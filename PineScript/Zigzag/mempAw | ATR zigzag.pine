// © d0m999
//@version=6
indicator("ATR ZigZag", "mempAw | ZigZag ATR", true, max_lines_count = 100, max_labels_count = 100)

// --- 参数输入 ---
atrLength            = input.int(10, "ATR/枢轴点周期", minval=1, inline="Lengths")
pivotLength          = input.int(3, "", minval=3, maxval=501, step=2, tooltip="枢轴点周期必须是奇数。", inline="Lengths")
atrMultiplier        = input.float(2, "ATR 乘数 (最小阈值)", minval=0, tooltip="一个新的枢轴点必须与前一个点的距离超过 N倍 ATR。")
maxLines             = input.int(497,  "显示最近 N 条 ZigZag 线", minval=2, maxval=497)
lineColor            = input.color(color.new(color.yellow, 20), "线条颜色")
lineWidth            = input.int(1, "线条宽度")
lineStyle            = input.string("实线", "线条样式", options=["实线", "虚线"])
pivotDotColor        = input.color(color.new(color.orange, 40), "枢轴点颜色")


// --- 数据结构 ---
var pivotIndices = array.new<int>()
var pivotValues  = array.new<float>()
var pivotTypes   = array.new<string>()
var zigZagLines  = array.new<line>()
var pivotDots    = array.new<label>() // 重新引入label数组来正确管理“点”


// --- 计算与辅助函数 ---
// 转换线条样式选择
lineStyling(choice) =>
    switch choice
        "虚线"      => line.style_dashed
        => line.style_solid

// 存储新的枢轴点
storePivot(pivot) =>
    // 垃圾回收逻辑
    if zigZagLines.size() == maxLines
        zigZagLines.first().delete()
        pivotDots.first().delete()
        pivotIndices.shift()
        pivotValues.shift()
        pivotTypes.shift()
        zigZagLines.shift()
        pivotDots.shift()
    
    // 存储新枢轴点的数据
    pivotIndex = bar_index - (pivotLength - 1) / 2
    pivotValue = pivot == "high" ? high[(pivotLength - 1) / 2] : low[(pivotLength - 1) / 2]
    pivotIndices.push(pivotIndex)
    pivotValues.push(pivotValue)
    pivotTypes.push(pivot == "high" ? "High" : "Low")

    // 创建一个新的“点”
    newDot = label.new(pivotIndex, pivotValue, "", style=label.style_circle, color=pivotDotColor, size=size.tiny, textcolor=color.new(color.white, 100))
    pivotDots.push(newDot)
    
    // 如果存在超过两个点，则创建并绘制一条新线
    if pivotIndices.size() >= 2
        newLine = line.new(
          x1=pivotIndices.get(pivotIndices.size() - 2), 
          y1=pivotValues.get(pivotValues.size() - 2), 
          x2=pivotIndices.last(), 
          y2=pivotValues.last(),
          color=lineColor,
          style=lineStyling(lineStyle),
          width=lineWidth)
        zigZagLines.push(newLine)

// 更新最后一个枢轴点
updatePivot(pivot) =>
    // 更新数据
    pivotIndex = bar_index - (pivotLength - 1) / 2
    pivotValue = pivot == "high" ? high[(pivotLength - 1) / 2] : low[(pivotLength - 1) / 2]
    pivotIndices.set(pivotIndices.size() - 1, pivotIndex)
    pivotValues.set(pivotValues.size() - 1, pivotValue)

    // 移动最后一条线和最后一个“点”的位置
    if zigZagLines.size() > 0
        zigZagLines.last().set_xy2(pivotIndex, pivotValue)
    if pivotDots.size() > 0
        pivotDots.last().set_xy(pivotIndex, pivotValue)


// --- 核心逻辑 ---
noError = pivotLength % 2 == 1 and bar_index >= pivotLength - 1
atr = ta.atr(atrLength)

if noError
    // 检测枢轴点的几何形状
    noHighPivot = false
    noLowPivot = false
    for i = pivotLength - 1 to 1
        if i > (pivotLength - 1) / 2
            if high[i] > high[i - 1]
                noHighPivot := true
            if low[i] < low[i - 1]
                noLowPivot := true
        if i <= (pivotLength - 1) / 2
            if high[i] < high[i - 1]
                noHighPivot := true
            if low[i] > low[i - 1]
                noLowPivot := true

    // 存储或更新枢轴点
    if pivotIndices.size() == 0
        if not noHighPivot
            storePivot("high")
        if not noLowPivot
            storePivot("low")
    else
        if pivotTypes.last() == "High"
            if not noHighPivot and high[(pivotLength - 1) / 2] > pivotValues.last()
                updatePivot("high")
            if not noLowPivot and not na(atr[(pivotLength - 1) / 2]) and math.abs(low[(pivotLength - 1) / 2] - pivotValues.last()) >= atr[(pivotLength - 1) / 2] * atrMultiplier and bar_index - (pivotLength - 1) / 2 != pivotIndices.last() and low[(pivotLength - 1) / 2] < pivotValues.last()
                storePivot("low")
        else // last pivot was Low
            if not noLowPivot and low[(pivotLength - 1) / 2] < pivotValues.last()
                updatePivot("low")
            if not noHighPivot and not na(atr[(pivotLength - 1) / 2]) and math.abs(high[(pivotLength - 1) / 2] - pivotValues.last()) >= atr[(pivotLength - 1) / 2] * atrMultiplier and bar_index - (pivotLength - 1) / 2 != pivotIndices.last() and high[(pivotLength - 1) / 2] > pivotValues.last()
                storePivot("high")

