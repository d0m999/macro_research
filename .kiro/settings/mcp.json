{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": ["fetch"]
    },
    "puppeteer": {
      "command": "uvx",
      "args": ["mcp-server-puppeteer"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": ["puppeteer_screenshot", "puppeteer_pdf", "puppeteer_click", "puppeteer_type", "puppeteer_select", "puppeteer_evaluate", "puppeteer_goto"]
    }
  }
}