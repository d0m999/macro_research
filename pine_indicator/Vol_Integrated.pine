//@version=6
indicator("Enhanced Volume Analyzer", overlay=false, shorttitle="[d0m999]Vol-Enhanced")
import TradingView/ta/9

// =================================================================================
// 参数设置
// =================================================================================
volume_group = "Volume Analysis"
volume_ma_length = input.int(title="Volume MA Length", defval=20, minval=1, group=volume_group)
volume_ma_long_multiplier = input.float(title="Long MA Multiplier", defval=2.0, minval=1.5, maxval=3.0, step=0.1, group=volume_group)
volume_spike_multiplier = input.float(title="Volume Spike Multiplier", defval=1.5, minval=1.0, step=0.1, group=volume_group)


divergence_group = "Volume-Price Divergence"
enable_divergence = input.bool(title="Enable Volume-Price Divergence", defval=true, group=divergence_group)
divergence_lookback = input.int(title="Divergence Lookback Period", defval=5, minval=3, maxval=30, group=divergence_group)
volume_decline_periods = input.int(title="Volume Decline Periods", defval=3, minval=2, maxval=5, group=divergence_group)
price_change_threshold = input.float(title="Price Change Threshold %", defval=1.0, minval=0.1, maxval=5.0, step=0.1, group=divergence_group)

display_group = "Display Settings"
show_volume_bars = input.bool(title="Show Volume Bars", defval=true, group=display_group)
show_volume_ma = input.bool(title="Show Volume MA", defval=true, group=display_group)
show_spike_signals = input.bool(title="Show Spike Signals", defval=true, group=display_group)
show_divergence_signals = input.bool(title="Show Divergence Signals", defval=true, group=display_group)

color_group = "Colors"
bullish_volume_color = input.color(defval=color.white, title="Bullish Volume Color", group=color_group)
bearish_volume_color = input.color(defval=color.blue, title="Bearish Volume Color", group=color_group)
spike_warning_color = input.color(defval=color.yellow, title="Volume Spike Color", group=color_group)
volume_ma_color = input.color(defval=color.gray, title="Volume MA Color", group=color_group)

// =================================================================================
// 核心计算
// =================================================================================

// 基础成交量指标（使用EMA提供更快的响应速度）
volume_ma = ta.ema(volume, volume_ma_length)
volume_ma_long = ta.ema(volume, int(volume_ma_length * volume_ma_long_multiplier))

// 价格变化检测
price_change = close - close[1]
price_change_pct = (price_change / close[1]) * 100
is_bullish_candle = close > open
is_bearish_candle = close < open

// =================================================================================
// 功能1：成交量异常检测
// =================================================================================

// 成交量异常检测
volume_spike = volume > volume_ma * volume_spike_multiplier



// =================================================================================
// 功能2：量价背离检测
// =================================================================================

// 价格趋势检测
price_trend_up = close > ta.highest(close[1], divergence_lookback)
price_trend_down = close < ta.lowest(close[1], divergence_lookback)
significant_price_move = math.abs(price_change_pct) > price_change_threshold

// 成交量趋势检测（使用EMA更快检测成交量变化）
volume_declining = volume < ta.ema(volume[1], volume_decline_periods)

// 量价背离检测
bearish_divergence = price_trend_up and volume_declining and significant_price_move
bullish_divergence = price_trend_down and volume_declining and significant_price_move

// =================================================================================
// 绘图系统
// =================================================================================

// 成交量柱状图颜色逻辑（分开确认）
volume_bar_color = volume_spike ? spike_warning_color :
                   is_bullish_candle ? bullish_volume_color : bearish_volume_color

// 绘制成交量柱状图
plot(show_volume_bars ? volume : na, 
     title="Volume", 
     color=volume_bar_color, 
     style=plot.style_columns, 
     linewidth=1)



// 绘制成交量移动平均线
plot(show_volume_ma ? volume_ma : na, 
     title="Volume MA", 
     color=color.new(volume_ma_color, 0), 
     linewidth=2)

plot(show_volume_ma ? volume_ma_long : na, 
     title="Volume MA Long", 
     color=color.new(volume_ma_color, 50), 
     linewidth=1, 
     style=plot.style_line)


// =================================================================================
// 背景色和填充
// =================================================================================

// 量价背离背景色（改为灰色）
divergence_bg = bearish_divergence or bullish_divergence ? color.new(color.gray, 50) : na
bgcolor(divergence_bg, title="Divergence Background")
