//@version=6
indicator("Integrated Adaptive Resonance with Dual Squeeze", overlay=false, shorttitle="mempAw | Adaptive Oscillator")
import TradingView/ta/9

// =================================================================================
// Adaptive Resonance Oscillator 参数
// =================================================================================
aro_group = "Adaptive Resonance Oscillator"
smooth = input.bool(title="Enable Smoothing", defval=true, group=aro_group)
smoothlength = input.int(title="Smoothing Length", defval=12, minval=1, group=aro_group)
medianLength = input.int(title="Frequency Detection Length", defval=100, minval=1, group=aro_group)

// 背离设置参数
plotBullish = input(title="Plot Bullish Divergences", defval=true, group=aro_group)
plotBear = input(title="Plot Bearish Divergences", defval=true, group=aro_group)
lbL = input(title="Divergence Pivot Detection Length", defval=20, group=aro_group, tooltip = "The larger this number, the less sensitive the divergence detecion is. A smaller number will detect smaller and/or shorter term divergences", display = display.data_window)
lbR = 1



// =================================================================================
// Dual Channel Squeeze 参数
// =================================================================================
squeeze_group = "Dual Channel Squeeze"
bbLength = input.int(20, "BB Length", group=squeeze_group)
bbMult = input.float(2.0, "BB Multiplier", group=squeeze_group)
kcLength = input.int(20, "KC Length", group=squeeze_group)
kcMult = input.float(1.5, "KC Multiplier", group=squeeze_group)
// 双通道统一使用EMA - 响应更快，适合短期交易，信号一致性更好

// 自适应挤压长度设置
enable_adaptive_squeeze = input.bool(false, "Adaptive Squeeze Lengths", group=squeeze_group, 
                                     tooltip="根据市场主导周期自动调整BB和KC长度，与RSI周期保持同步。基于period与默认值的比例调整，限制在0.5-2.5倍范围内避免极端值")
show_debug_table = input.bool(false, "Show Debug Table", group=squeeze_group, 
                              tooltip="显示当前自适应参数的调试信息表格")

// =================================================================================
// 颜色设置参数
// =================================================================================
color_group = "Colors"
white = input.color(defval = color.white, title = "Bullish Color (上涨/看涨颜色)", group = color_group)
blue = input.color(defval = color.blue, title = "Bearish Color (下跌/看跌颜色)", group = color_group)
squeezeColor = input.color(color.new(color.white, 85), "Squeeze Background (挤压背景)", group=color_group)
// 注释：颜色配置 - 白色代表上涨/看涨信号，蓝色代表下跌/看跌信号

// =================================================================================
// Adaptive Resonance Oscillator 核心计算
// =================================================================================

// 自定义RSI计算函数
pine_rsi(x, y) => 
    u = math.max(x - x[1], 0)
    d = math.max(x[1] - x, 0)
    alpha = 1 / y
    sum_u = 0.0
    sum_d = 0.0
    sum_u := alpha * u + (1 - alpha) * nz(sum_u[1])
    sum_d := alpha * d + (1 - alpha) * nz(sum_d[1])
    rs = sum_u / sum_d
    res = 100 - 100 / (1 + rs)
    res

// 自定义RMA计算函数 - 解决ta.rma的series int参数限制
// RMA (Relative Moving Average) 也称为 Wilder's Moving Average
pine_rma(src, length) =>
    alpha = 1.0 / length
    var rma = 0.0
    rma := na(rma[1]) ? src : alpha * src + (1 - alpha) * rma[1]
    rma

// 自定义ATR计算函数 - 解决ta.atr的series int参数限制
// 功能与ta.atr完全相同，但可以接受series int参数，支持自适应长度
pine_atr(length) =>
    trueRange = na(high[1]) ? high - low : math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
    pine_rma(trueRange, length)

// 自定义EMA计算函数 - 解决ta.ema的series int参数限制
// 功能与ta.ema完全相同，但可以接受series int参数，支持自适应长度
pine_ema(src, length) =>
    alpha = 2.0 / (length + 1)
    var ema = 0.0
    ema := na(ema[1]) ? src : alpha * src + (1 - alpha) * ema[1]
    ema

// 自定义标准差计算函数 - 解决ta.stdev的series int参数限制
// 功能与ta.stdev完全相同，但可以接受series int参数，支持自适应长度
pine_stdev(src, length) =>
    mean = pine_ema(src, length)
    sum_sq_diff = 0.0
    alpha = 2.0 / (length + 1)
    sq_diff = math.pow(src - mean, 2)
    sum_sq_diff := na(sum_sq_diff[1]) ? sq_diff : alpha * sq_diff + (1 - alpha) * sum_sq_diff[1]
    math.sqrt(sum_sq_diff)



// 反正切函数实现
f_atan2(y, x) =>
    ret = x > 0 ? math.atan(y / x) :
          x < 0 and y >= 0 ? math.atan(y / x) + math.pi :
          x < 0 and y < 0  ? math.atan(y / x) - math.pi :
          y > 0 ? math.pi / 2 : y < 0 ? -math.pi / 2 : 0.0
    ret

// 价格数据准备和处理
price = close
priceSmooth = (price + price[1] + price[2] + price[3]) / 4

// 去趋势处理
detrender = (0.0962 * priceSmooth 
             + 0.5769 * priceSmooth[2] 
             - 0.5769 * priceSmooth[4] 
             - 0.0962 * priceSmooth[6])

// 希尔伯特变换
I1 = detrender[3]
Q1 = (0.0962 * detrender 
      + 0.5769 * detrender[2] 
      - 0.5769 * detrender[4] 
      - 0.0962 * detrender[6])
    
jI = I1[3]
jQ = Q1[3]

I2 = I1 - jQ
Q2 = Q1 + jI

Re = I2 * nz(I2[1]) + Q2 * nz(Q2[1])
Im = I2 * nz(Q2[1]) - Q2 * nz(I2[1])

phaseAngle = math.todegrees(f_atan2(Im, Re))
phaseAngle := phaseAngle < 0 ? phaseAngle + 360 : phaseAngle

minPhase = 1.0
phaseAngleClamped = math.max(phaseAngle, minPhase)

hilbertPeriodRaw = 360 / phaseAngleClamped
market_frequency = ta.median(hilbertPeriodRaw, medianLength)
period = int(market_frequency / 2)

// 计算RSI
base_rsi = pine_rsi(close, period)
rsi_v = smooth ? ta.hma(base_rsi, smoothlength) : base_rsi

// =================================================================================
// Dual Channel Squeeze 核心计算
// =================================================================================

// 自适应长度计算 - 基于市场主导周期
// 使用条件表达式直接在函数调用中选择长度，避免series int问题

// 布林带计算 - 统一使用EMA基础，自适应长度
bbBasis = enable_adaptive_squeeze ? pine_ema(close, period) : pine_ema(close, bbLength)
bbDev = enable_adaptive_squeeze ? bbMult * pine_stdev(close, period) : bbMult * pine_stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// 肯特纳通道计算 - 统一使用EMA基础，自适应长度
kcBasis = enable_adaptive_squeeze ? pine_ema(close, period) : pine_ema(close, kcLength)
kcDev = enable_adaptive_squeeze ? kcMult * pine_atr(period) : kcMult * pine_atr(kcLength)
kcUpper = kcBasis + kcDev
kcLower = kcBasis - kcDev

// 识别挤压状态
isSqueeze = (bbUpper < kcUpper) and (bbLower > kcLower)
squeezeFired = isSqueeze[1] and not isSqueeze

// 挤压状态检测完成，无需动量计算

// =================================================================================
// 绘图 - Adaptive Resonance Oscillator
// =================================================================================

// 绘制超买超卖区域的RSI值
plot(rsi_v > 80 or rsi_v < 20 ? rsi_v : na, color = smooth ? (rsi_v > rsi_v[1] ? white : blue) : color.white, linewidth = 4, style=plot.style_steplinebr)
// 注释：当RSI在超买(>80)或超卖(<20)区域时，上涨显示白色，下跌显示蓝色

// 绘制主RSI线
rsi_plot = plot(rsi_v, color = smooth ? color.new((rsi_v > rsi_v[1] ? white : blue), 50) : color.white, linewidth = 1, style=plot.style_stepline)
rsi_plot1 = plot(rsi_v[1], color = smooth ? color.new((rsi_v > rsi_v[1] ? white : blue), 100) : color.new(color.white, 100), linewidth = 1, style=plot.style_stepline)
// 注释：主RSI线，上涨趋势显示白色，下跌趋势显示蓝色

// 绘制上下阈值带
upper_band = plot(80, "Upper Band", color.new(color.gray, 50), 2)
lower_band = plot(20, "Lower Band", color.new(color.gray, 50), 2)

// 设置颜色
col = rsi_v > 50 ? white : blue  // 修改：RSI>50时用白色(看涨)，RSI<50时用蓝色(看跌)

// 绘制信号标记
plotchar(ta.crossover(rsi_v, rsi_v[1]) and (rsi_v[1] < 20) ? rsi_v - 7 : na, char='▲', location=location.absolute, color=white, textcolor=color.black, title="Strong Bullish", display= smooth ? display.all : display.none, size=size.tiny)
// 注释：强看涨信号，从超卖区域向上突破时显示白色三角形
plotchar(ta.crossunder(rsi_v, rsi_v[1]) and (rsi_v[1] > 80) ? rsi_v + 7 : na, char='▼', location=location.absolute, color=blue, textcolor=color.white, title="Strong Bearish", display= smooth ? display.all : display.none, size=size.tiny)
// 注释：强看跌信号，从超买区域向下突破时显示蓝色倒三角形

// =================================================================================
// 背离检测
// =================================================================================

// 颜色定义
bullColor = white  // 修改：看涨背离用白色
bearColor = blue   // 修改：看跌背离用蓝色
hiddenBullColor = color.new(white, 80)  // 修改：隐藏看涨背离用半透明白色
hiddenBearColor = color.new(blue, 80)   // 修改：隐藏看跌背离用半透明蓝色
textColor = color.white
noneColor = color.new(color.white, 100)

// 检测RSI的低点和高点
plFound = na(ta.pivotlow(rsi_v, lbL, lbR)) ? false : true
phFound = na(ta.pivothigh(rsi_v, lbL, lbR)) ? false : true

// 辅助函数
_inRange(cond) =>
	bars = ta.barssince(cond == true)
	-80 <= bars and bars <= 80

// 检测常规看涨背离
oscHL = rsi_v[lbR] > ta.valuewhen(plFound, rsi_v[lbR], 1) and _inRange(plFound[1])
priceLL = low[lbR] < ta.valuewhen(plFound, low[lbR], 1)
bullCond = plotBullish and priceLL and oscHL and plFound
plot(plFound  ? rsi_v[lbR] : na, offset=-lbR, title="Regular Bullish", linewidth=2, color=(bullCond ? bullColor : noneColor))
// 注释：常规看涨背离检测，价格创新低但RSI未创新低时显示白色线条

// 检测常规看跌背离
oscLH = rsi_v[lbR] < ta.valuewhen(phFound, rsi_v[lbR], 1) and _inRange(phFound[1])
priceHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
bearCond = plotBear and priceHH and oscLH and phFound
plot(phFound  ? rsi_v[lbR] : na, offset=-lbR, title="Regular Bearish", linewidth=2, color=(bearCond ? bearColor : noneColor))
// 注释：常规看跌背离检测，价格创新高但RSI未创新高时显示蓝色线条

// =================================================================================
// Dual Channel Squeeze 背景色显示
// =================================================================================

// 创建背景色边界线（隐藏），限制背景色在RSI上下阈值线范围显示
squeeze_bg_top = plot(80, color=color.new(color.white, 100), display=display.none, title="Squeeze BG Top")
squeeze_bg_bottom = plot(20, color=color.new(color.white, 100), display=display.none, title="Squeeze BG Bottom")

// 挤压状态背景色显示 - 使用单色显示
fill(squeeze_bg_bottom, squeeze_bg_top, 
     color = isSqueeze ? squeezeColor : na,
     title="Squeeze Background")
// 注释：挤压状态背景色，统一使用白色背景显示，范围限制在RSI上下阈值线之间（20-80）

// =================================================================================
// 警报
// =================================================================================

// 背离警报
alertcondition(bullCond or bearCond, title="Divergence", message="Divergence Detected")

// 强烈信号警报
alertcondition((ta.crossover(rsi_v, rsi_v[1]) and (rsi_v[1] < 20)) or (ta.crossunder(rsi_v, rsi_v[1]) and (rsi_v[1] > 80)), title="Strong Signal", message="Strong Bullish or Bearish Signal Detected")

// =================================================================================
// 调试信息表格
// =================================================================================

// 创建调试信息表格
if show_debug_table and barstate.islast
    var debug_table = table.new(position.top_right, 2, 5, bgcolor=color.new(color.navy, 80), border_width=1)
    
    // 表格标题
    table.cell(debug_table, 0, 0, "Parameter", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 50))
    table.cell(debug_table, 1, 0, "Value", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 50))
    
    // 显示当前参数值
    table.cell(debug_table, 0, 1, "Market Period", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 1, 1, str.tostring(period, "#"), text_color=color.yellow, text_size=size.tiny)
    
    table.cell(debug_table, 0, 2, "BB Length", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 1, 2, str.tostring(enable_adaptive_squeeze ? period : bbLength, "#"), text_color=enable_adaptive_squeeze ? color.lime : color.gray, text_size=size.tiny)
    
    table.cell(debug_table, 0, 3, "KC Length", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 1, 3, str.tostring(enable_adaptive_squeeze ? period : kcLength, "#"), text_color=enable_adaptive_squeeze ? color.lime : color.gray, text_size=size.tiny)
    
    table.cell(debug_table, 0, 4, "Adaptive Mode", text_color=color.white, text_size=size.tiny)
    table.cell(debug_table, 1, 4, enable_adaptive_squeeze ? "ON" : "OFF", text_color=enable_adaptive_squeeze ? color.lime : color.red, text_size=size.tiny)

// 挤压警报
if squeezeFired
    string adaptive_info = enable_adaptive_squeeze ? " (Adaptive Length: " + str.tostring(period, "#") + ")" : ""
    string alertMessage = "Dual-Channel Squeeze has fired" + adaptive_info + " on " + syminfo.ticker + "."
    alert(alertMessage, alert.freq_once_per_bar)