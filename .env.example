# =============================================================================
# FreqTrade 环境变量模板
# =============================================================================
# 复制为 .env 并填入真实值: cp .env.example .env
# .env 已在 .gitignore 中,不会被提交
# =============================================================================

# -----------------------------------------------------------------------------
# 🔑 交易所 API (Binance)
# -----------------------------------------------------------------------------
# Required (仅实盘需要,dry_run=true 时可保持占位符)
EXCHANGE_API_KEY=your_real_api_key_here
EXCHANGE_API_SECRET=your_real_api_secret_here

# -----------------------------------------------------------------------------
# 🔐 JWT / WebSocket 安全密钥
# -----------------------------------------------------------------------------
# Required. 用以下命令生成 64 位十六进制:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_me_with_secrets_token_hex_32

# 用以下命令生成 32 位十六进制:
#   python -c "import secrets; print(secrets.token_hex(16))"
WS_TOKEN=replace_me_with_secrets_token_hex_16

# -----------------------------------------------------------------------------
# 👤 API Server 认证 (FreqTrade webserver @ :8081)
# -----------------------------------------------------------------------------
# Required. 强密码建议:
#   python -c "import secrets; from base64 import b64encode; print(b64encode(secrets.token_bytes(24)).decode())"
API_USERNAME=freqtrader_secure
API_PASSWORD=replace_me_with_base64_password

# -----------------------------------------------------------------------------
# 📱 Telegram 机器人 (可选)
# -----------------------------------------------------------------------------
# Optional. 从 @BotFather 获取 token,从 @userinfobot 获取 chat_id
# TELEGRAM_TOKEN=bot_id:auth_token
# TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# 💾 数据库
# -----------------------------------------------------------------------------
# Default for Docker; local dev: sqlite:///user_data/tradesv3.sqlite
DB_URL=sqlite:////freqtrade/user_data/tradesv3.sqlite

# -----------------------------------------------------------------------------
# 🆕 OKX 只读 API (dashboard/fetch_trades.py)
# -----------------------------------------------------------------------------
# Required for dashboard. 在 OKX 后台创建:
#   API 权限: 只读 (Read-Only)
#   用途: 查看账户、交易、持仓
# ⚠️ 严禁开启交易权限 ⚠️
OKX_API_KEY=replace_me_with_okx_api_key_uuid
OKX_SECRET=replace_me_with_okx_secret_hex
OKX_PASSPHRASE=replace_me_with_okx_passphrase
